---
interface Props {
  id: string;
  title: string;
  icon: string;
  defaultOpen?: boolean;
}

const { id, title, icon, defaultOpen = false } = Astro.props;
---

<div class:list={["accordion-item", { "is-open": defaultOpen }]} data-accordion={id}>
  <button class="accordion-trigger" aria-expanded={defaultOpen ? "true" : "false"} aria-controls={`content-${id}`}>
    <span class="icon" set:html={icon} />
    <span>{title}</span>
    <svg class="chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </button>
  <div class="accordion-content" id={`content-${id}`}>
    <slot />
  </div>
</div>
