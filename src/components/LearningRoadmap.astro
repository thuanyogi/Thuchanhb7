---
import { getCourseSessions, getPhaseGroups } from "../lib/course";

const sessions = getCourseSessions();
const phaseGroups = getPhaseGroups(sessions);

const phaseColors: Record<string, string> = {
  "Operate": "var(--phase-operate)",
  "Modify": "var(--phase-modify)",
  "Create": "var(--phase-create)",
  "Presentation": "var(--phase-presentation)"
};

const phaseHex: Record<string, string> = {
  "Operate": "#0d9488",
  "Modify": "#6366f1",
  "Create": "#f97316",
  "Presentation": "#e64a19"
};

const phaseDescriptions: Record<string, string> = {
  "Operate": "Làm quen hệ thống, vận hành quy trình PDCA và workflow cơ bản",
  "Modify": "Tùy chỉnh Agent, Knowledge, Rules và kiểm soát chất lượng AI",
  "Create": "Xây dựng giải pháp AI Agent thực tế cho doanh nghiệp",
  "Presentation": "Trình bày dự án cuối khóa và đánh giá tổng kết"
};

const phaseIcons: Record<string, string> = {
  "Operate": `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>`,
  "Modify": `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`,
  "Create": `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>`,
  "Presentation": `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>`
};
---

<div class="roadmap-container">
  <div class="roadmap-header">
    <span class="roadmap-eyebrow">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      Học phần thực chiến
    </span>
    <h2>Hành trình 12 Buổi học & Sản phẩm chinh phục</h2>
    <p>Con đường chinh phục công nghệ AI Agent từ vận hành cơ bản, làm chủ tối ưu đến sáng tạo giải pháp thực tế đưa vào vận hành doanh nghiệp tự động.</p>
  </div>

  <div class="roadmap-interactive-wrapper">
    <!-- Desktop Descending Stepped Layout -->
    <div class="staircase-descending-layout">
      {phaseGroups.map((group, index) => (
        <div class="cascade-row" style={`--indent: ${index}; --phase-color: ${phaseColors[group.phase]}`}>
          
          <div class="row-icon-col">
            <div class="cascade-icon" set:html={phaseIcons[group.phase]} />
            
            {/* Dynamic S-Curve Connector to Next Step */}
            {index < 3 && (
              <div class="cascade-connector">
                <svg width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id={`curve-grad-${index}`} x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color={phaseColors[group.phase]} />
                      <stop offset="100%" stop-color={phaseColors[phaseGroups[index+1].phase]} />
                    </linearGradient>
                  </defs>
                  <path 
                    d="M0,0 C0,60 100,40 100,100" 
                    fill="none" 
                    stroke={`url(#curve-grad-${index})`} 
                    stroke-width="5" 
                    vector-effect="non-scaling-stroke" 
                    stroke-linecap="round" 
                  />
                </svg>
              </div>
            )}

            {/* Straight Connector to Summit Badge for Last Step */}
            {index === 3 && (
              <div class="cascade-connector summit-connector">
                <svg width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
                  <path 
                    d="M0,0 L0,100" 
                    fill="none" 
                    stroke={phaseColors[group.phase]} 
                    stroke-width="5" 
                    vector-effect="non-scaling-stroke" 
                    stroke-dasharray="8 8"
                  />
                </svg>
              </div>
            )}
          </div>

          <div class="cascade-card">
            <div class="card-header">
              <div class="card-title-row">
                <span class="phase-badge" style={`background: var(--phase-color)`}>{index + 1}</span>
                <h3 class="card-title">Phase {index + 1} — {group.phase}</h3>
                <span class="session-count">{group.sessions.length} buổi</span>
              </div>
              <p class="card-desc">{phaseDescriptions[group.phase]}</p>
            </div>
            <div class="card-sessions">
              {group.sessions.map((session) => (
                <a href={`/sessions/${session.slug}/`} class="session-chip">
                  <span class="chip-num">Buổi {session.number}</span>
                  <span class="chip-topic">{session.topic}</span>
                  <svg class="chip-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </a>
              ))}
            </div>
          </div>

        </div>
      ))}

      <!-- The Final Summit Badge -->
      <div class="summit-row">
        <div class="summit-badge">
          <div class="summit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 12h7v10h6V12h7L12 2z"/></svg>
          </div>
          <div class="summit-text">
            <span class="summit-label">Đích đến cuối cùng</span>
            <span class="summit-title">Sở hữu Hệ thống AI Agent Vận hành Doanh nghiệp Tự động</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile fallback -->
    <div class="roadmap-mobile">
      {phaseGroups.map((group, phaseIndex) => (
        <div class="mobile-phase" style={`--phase-color: ${phaseColors[group.phase]}`}>
          <div class="mobile-phase-header">
            <div class="mobile-phase-num">{phaseIndex + 1}</div>
            <div>
              <h3 class="mobile-phase-name">
                <span class="mobile-icon" set:html={phaseIcons[group.phase]} />
                {group.phase}
              </h3>
              <p class="mobile-phase-desc">{phaseDescriptions[group.phase]}</p>
            </div>
          </div>
          <div class="mobile-sessions">
            {group.sessions.map((session) => (
              <a href={`/sessions/${session.slug}/`} class="mobile-session-chip">
                <span class="chip-num">Buổi {session.number}</span>
                <span class="chip-topic">{session.topic}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
  @import "../styles/learning-roadmap.css";
</style>
