---
interface Props {
  id: string;
  title: string;
  text: string;
  note?: string;
}

const { id, title, text, note } = Astro.props;
---

{
  text?.trim() && (
    <section class="copy-panel">
      <div>
        <h3>{title}</h3>
        {note && <p>{note}</p>}
      </div>
      <button type="button" class="copy-button" data-copy-target={id}>Copy</button>
      <textarea id={id} readonly>{text.trim()}</textarea>
    </section>
  )
}
