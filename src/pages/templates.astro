<BaseLayout title="Starter Templates">
  <div class="templates-page-container">
    <header class="page-header">
      <div class="header-badge">🚀 Starter Kits</div>
      <h1>Mẫu làm bài cho học viên</h1>
      <p class="subtitle">Không bắt đầu từ trang giấy trắng. Dưới đây là các cấu trúc chuẩn hóa được thiết kế riêng để học viên tải về, copy nhanh và áp dụng trực tiếp vào các buổi thực hành.</p>
    </header>

    <div class="templates-layout">
      <!-- Sidebar navigation for quick scrolling -->
      <aside class="templates-sidebar">
        <h3>Danh mục template</h3>
        <nav class="sidebar-nav">
          {templates.map((t) => (
            <a href={`#card-${t.id}`} class="sidebar-link">
              <span class="sidebar-icon">{t.icon}</span>
              <span class="sidebar-title">{t.title}</span>
            </a>
          ))}
        </nav>
      </aside>

      <!-- Main list of templates -->
      <main class="templates-main">
        {templates.map((template) => (
          <article class="template-card" id={`card-${template.id}`}>
            <div class="card-header">
              <div class="card-title-row">
                <span class="card-icon">{template.icon}</span>
                <div>
                  <h2>{template.title}</h2>
                  <p class="card-use">{template.use}</p>
                </div>
              </div>
            </div>

            <!-- Tabs buttons -->
            <div class="tab-buttons" data-template-id={template.id}>
              <button class="tab-btn active" data-tab="structure">
                📋 Cấu trúc & Hướng dẫn
              </button>
              <button class="tab-btn" data-tab="example">
                💡 Ví dụ thực tế
              </button>
              <button class="tab-btn" data-tab="markdown">
                ⚡ Markdown nguồn
              </button>
            </div>

            <!-- Tab Contents -->
            <div class="tab-panes" id={`panes-${template.id}`}>
              <!-- Pane 1: Structure -->
              <div class="tab-pane active" data-pane="structure">
                <div class="structure-list">
                  {template.fields.map((f) => (
                    <div class="field-item">
                      <strong>{f.name}</strong>
                      <p>{f.desc}</p>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Pane 2: Real Example -->
              <div class="tab-pane" data-pane="example" set:html={template.exampleHtml} />

              <!-- Pane 3: Raw Markdown with copy option -->
              <div class="tab-pane" data-pane="markdown">
                <div class="code-wrapper">
                  <button class="copy-code-btn" data-copy-target={`code-${template.id}`}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <span>Copy</span>
                  </button>
                  <pre><code id={`code-${template.id}`}>{template.markdown}</code></pre>
                </div>
              </div>
            </div>
          </article>
        ))}
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .templates-page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
  }

  .page-header {
    margin-bottom: var(--space-2xl);
    text-align: left;
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-xl);
  }

  .header-badge {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 20px;
    background: var(--accent-primary-bg);
    color: var(--accent-primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }

  .page-header h1 {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 var(--space-sm);
    line-height: 1.2;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 800px;
    line-height: 1.6;
    margin: 0;
  }

  /* Layout grid */
  .templates-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  /* Sidebar styling */
  .templates-sidebar {
    position: sticky;
    top: 84px;
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
  }

  .templates-sidebar h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 0 0 var(--space-md);
    padding-left: var(--space-xs);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 500;
    transition: all var(--duration-fast);
  }

  .sidebar-link:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .sidebar-icon {
    font-size: 1.1rem;
  }

  /* Main components list */
  .templates-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .template-card {
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    scroll-margin-top: 84px;
    transition: border-color var(--duration-normal);
  }

  .template-card:hover {
    border-color: var(--border-strong);
  }

  .card-header {
    padding: var(--space-lg) var(--space-xl);
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .card-title-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .card-icon {
    font-size: 1.8rem;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
  }

  .template-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 var(--space-xs);
    line-height: 1.3;
  }

  .card-use {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Tabs controller styling */
  .tab-buttons {
    display: flex;
    border-bottom: 1px solid var(--border);
    background: var(--bg-inset);
    padding: 0 var(--space-lg);
    gap: 8px;
  }

  .tab-btn {
    background: none;
    border: none;
    padding: var(--space-md) var(--space-sm);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all var(--duration-fast);
  }

  .tab-btn:hover {
    color: var(--text-primary);
  }

  .tab-btn.active {
    color: var(--accent-primary);
    border-bottom-color: var(--accent-primary);
  }

  /* Tab panes */
  .tab-panes {
    padding: var(--space-xl);
  }

  .tab-pane {
    display: none;
  }

  .tab-pane.active {
    display: block;
    animation: fadeIn 0.2s ease-out;
  }

  /* Pane 1 Structure grid */
  .structure-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .field-item {
    background: var(--bg-inset);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .field-item strong {
    font-size: 0.92rem;
    color: var(--text-primary);
    display: block;
    margin-bottom: var(--space-xs);
  }

  .field-item p {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  /* Pane 2 Real Example styling */
  :global(.example-content) {
    background: color-mix(in srgb, var(--accent-teal) 5%, var(--bg-base));
    border-left: 4px solid var(--accent-teal);
    padding: var(--space-lg) var(--space-xl);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  :global(.example-content h4) {
    color: var(--accent-teal-dark, var(--text-primary));
    font-size: 0.95rem;
    margin-bottom: var(--space-md);
  }

  :global(.example-content p) {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-sm);
  }

  :global(.example-content p:last-child) {
    margin-bottom: 0;
  }

  /* Pane 3 Code box styling */
  .code-wrapper {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #0f141c;
    border: 1px solid #1a2333;
  }

  .code-wrapper pre {
    margin: 0;
    padding: var(--space-lg);
    overflow-x: auto;
  }

  .code-wrapper code {
    color: #e5e9f0;
    font-size: 0.85rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }

  .copy-code-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #cbd5e1;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
  }

  .copy-code-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: white;
  }

  .copy-code-btn.copied {
    background: var(--success);
    border-color: var(--success);
    color: white;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Responsive styling */
  @media (max-width: 960px) {
    .templates-layout {
      grid-template-columns: 1fr;
    }

    .templates-sidebar {
      position: static;
      margin-bottom: var(--space-md);
    }

    .sidebar-nav {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 600px) {
    .structure-list {
      grid-template-columns: 1fr;
    }

    .tab-buttons {
      padding: 0 var(--space-sm);
      overflow-x: auto;
      white-space: nowrap;
    }

    .tab-btn {
      padding: var(--space-md) var(--space-xs);
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    /* Handle tabs switches */
    document.querySelectorAll('.tab-buttons').forEach(buttonsContainer => {
      const templateId = buttonsContainer.dataset.templateId;
      const panesContainer = document.getElementById(`panes-${templateId}`);
      if (!panesContainer) return;

      const buttons = buttonsContainer.querySelectorAll('.tab-btn');
      const panes = panesContainer.querySelectorAll('[data-pane]');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const tabName = btn.dataset.tab;
          
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          panes.forEach(pane => {
            if (pane.dataset.pane === tabName) {
              pane.classList.add('active');
            } else {
              pane.classList.remove('active');
            }
          });
        });
      });
    });

    /* Handle Code Clipboard Copies */
    document.querySelectorAll('.copy-code-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.copyTarget;
        const codeElement = document.getElementById(targetId);
        if (!codeElement) return;

        navigator.clipboard.writeText(codeElement.innerText)
          .then(() => {
            const originalHtml = btn.innerHTML;
            btn.innerHTML = `
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Đã copy!</span>
            `;
            btn.classList.add('copied');

            setTimeout(() => {
              btn.innerHTML = originalHtml;
              btn.classList.remove('copied');
            }, 2000);
          })
          .catch(err => {
            console.error('Không thể copy code: ', err);
          });
      });
    });
  });
</script>
