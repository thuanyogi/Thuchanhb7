---
import BaseLayout from "../layouts/BaseLayout.astro";
import StreakStrip from "../components/StreakStrip.astro";
import { getCourseSessions, getCourseStats } from "../lib/course";
import LearningRoadmap from "../components/LearningRoadmap.astro";

const sessions = getCourseSessions();
const stats = getCourseStats(sessions);
---

<BaseLayout title="Trang chủ">
  <!-- Hero Section -->
  <section class="hero-section-wrapper">
    <div class="hero-content">
      <div class="eyebrow-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        <span>Thuận Yogi · Agentic AI Mentor</span>
      </div>
      <h1>12 buổi. 1 quy trình.<br/><span class="gradient-text">Mỗi buổi ra 1 artifact đo được.</span></h1>
      <p class="hero-desc">
        Bắt đầu từ quy trình, không từ tool. Bạn vận hành, tối ưu và lắp ráp một Agentic Workspace thật — mỗi buổi nộp 1 artifact, mỗi vòng PDCA đo được cải tiến. Sáng với AI, chiều với Yoga.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={`/sessions/`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Bắt đầu Học ngay
        </a>
        <a class="button button-secondary" href="/templates/">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          Thư viện Templates
        </a>
      </div>
    </div>

    <!-- Course Overview Panel -->
    <aside class="overview-dashboard">
      <h3>Thông số lộ trình</h3>
      <div class="dashboard-grid">
        <div class="dashboard-stat">
          <span class="stat-number">{stats.sessionCount}</span>
          <span class="stat-label">Buổi học thực chiến</span>
        </div>
        <div class="dashboard-stat">
          <span class="stat-number">{stats.phaseCount}</span>
          <span class="stat-label">Giai đoạn cốt lõi</span>
        </div>
        <div class="dashboard-stat">
          <span class="stat-number">{stats.artifactCount}</span>
          <span class="stat-label">Sản phẩm đầu ra</span>
        </div>
        <div class="dashboard-stat">
          <span class="stat-number">{stats.checklistCount}</span>
          <span class="stat-label">Checkpoints tự kiểm</span>
        </div>
      </div>
      <StreakStrip />
      <div class="dashboard-footer-info">
        <span class="badge-dot">●</span> Đánh giá năng lực dựa trên Rubric kiểm duyệt thực tế.
      </div>
    </aside>
  </section>

  <!-- Resume card for returning users (shown via JS if progress exists) -->
  <section class="home-resume" id="home-resume" style="display:none;">
    <div class="resume-card">
      <div class="resume-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      </div>
      <div class="resume-text">
        <strong>Tiếp tục học</strong>
        <span id="home-resume-text">Nhảy tới buổi bạn xem gần nhất.</span>
      </div>
      <a class="resume-link" id="home-resume-link" href="/sessions/">
        Vào học ngay
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </div>
  </section>

  <!-- Interactive Learning Roadmap -->
  <section class="roadmap-section-band">
    <LearningRoadmap />
  </section>

  <!-- App Features Highlights -->
  <section class="features-section">
    <div class="features-header">
      <span class="roadmap-eyebrow">Tiện ích học viên</span>
      <h2>Học theo quy trình, tìm trong vài giây</h2>
    </div>
    <div class="features-grid stagger-fade">
      <div class="feature-card">
        <div class="feature-icon" style="--icon-color: var(--accent-primary);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
        <h3>Tìm kiếm toàn khoá (⌘K)</h3>
        <p>Nhấn Cmd+K để tìm buổi học, thuật ngữ, template — nhảy tới đúng mục trong vài giây. Không cuộn vô tận.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon" style="--icon-color: var(--accent-teal);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 4 12 14.01 9 11.01"/><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/></svg>
        </div>
        <h3>Theo dõi tiến độ thật</h3>
        <p>Mỗi buổi có checklist tự kiểm, lưu tự động. Biết mình đang ở đâu, còn thiếu gì — đo được, không đoán.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon" style="--icon-color: var(--accent-indigo);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </div>
        <h3>Copy prompt 1-click</h3>
        <p>Prompt, kịch bản demo, bài thực hành đều copy ngay. Bắt đầu từ quy trình, tool chỉ là công cụ.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon" style="--icon-color: var(--accent-orange, #f97316);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <h3>Gỡ lỗi khi bị kẹt</h3>
        <p>Mỗi buổi tích hợp sẵn lỗi hay gặp và cách sửa. Đối chiếu, sửa, chạy lại — đúng vòng PDCA.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Home resume card (P1) */
  .home-resume {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
    padding: var(--space-md) 0 0;
  }

  /* Hero area styling */
  .hero-section-wrapper {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-2xl);
    padding: var(--space-3xl) 0 var(--space-xl);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .eyebrow-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 6px 12px;
    border-radius: 30px;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 500;
    margin-bottom: var(--space-md);
  }

  .eyebrow-badge svg {
    color: var(--accent-primary);
  }

  .hero-content h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 var(--space-md);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-indigo));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero-desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-xl);
    max-width: 600px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* Overview Dashboard styling */
  .overview-dashboard {
    background: var(--bg-base);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    padding: var(--space-xl) var(--space-2xl);
    box-shadow: var(--shadow-lg);
  }

  .overview-dashboard h3 {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin: 0 0 var(--space-lg);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-sm);
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .dashboard-stat {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-size: 2.25rem;
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: var(--space-xs);
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 500;
    line-height: 1.3;
  }

  .dashboard-footer-info {
    margin-top: var(--space-xl);
    font-size: 0.78rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .badge-dot {
    color: var(--success);
    font-size: 1.1rem;
    line-height: 1;
  }

  /* Band spacing */
  .roadmap-section-band {
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Features block */
  .features-section {
    padding: var(--space-3xl) 0;
  }

  .features-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .roadmap-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--accent-primary-bg);
    color: var(--accent-primary);
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: var(--space-xs);
  }

  .features-header h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .feature-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-base);
    padding: var(--space-lg);
    transition: all var(--duration-normal) var(--ease-out);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .feature-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .feature-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--icon-color) 10%, transparent);
    color: var(--icon-color);
    margin-bottom: var(--space-md);
  }

  .feature-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 var(--space-sm);
  }

  .feature-card p {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Responsive homepage */
  @media (max-width: 960px) {
    .hero-section-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
