---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StreakStrip from "../../components/StreakStrip.astro";
import ModuleStatusIcon from "../../components/ModuleStatusIcon.astro";
import { getCourseSessions, getPhaseGroups, type CourseSession } from "../../lib/course";
import { buildClassroomPlan } from "../../lib/classroom-plan";

const sessions = getCourseSessions();
const groups = getPhaseGroups(sessions);
const totalSessions = sessions.length;
const planMap = new Map(sessions.map((s) => [s.number, buildClassroomPlan(s)]));
const totalChecks = (s: CourseSession) => (planMap.get(s.number)?.student.beforeClass.length ?? 0) + s.guidance.successCriteria.length;

const phaseIcons: Record<string, string> = {
  "Operate": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
  "Modify": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  "Create": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>`,
  "Presentation": `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`
};

const phaseColors: Record<string, string> = {
  "Operate": "var(--phase-operate, #0d9488)",
  "Modify": "var(--phase-modify, #6366f1)",
  "Create": "var(--phase-create, #f97316)",
  "Presentation": "var(--phase-presentation, #e64a19)"
};
---

<BaseLayout title="Student Dashboard — Lộ trình học">
  <div class="dashboard">
    <!-- Header -->
    <header class="dash-header">
      <div class="dash-header-text">
        <span class="dash-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          Student Dashboard
        </span>
        <h1>Lộ trình học & Theo dõi tiến độ</h1>
        <p>Theo dõi hành trình {totalSessions} buổi học, kiểm tra artifact cần nộp và checklist hoàn thành từng giai đoạn.</p>
      </div>

      <!-- Global progress card -->
      <div class="global-progress" id="global-progress">
        <div class="progress-ring-big">
          <svg viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="52" fill="none" stroke="var(--border, #e2e8f0)" stroke-width="8"/>
            <circle cx="60" cy="60" r="52" fill="none" stroke="var(--accent-primary, #e64a19)" stroke-width="8"
              stroke-dasharray="326.7" stroke-dashoffset="326.7" stroke-linecap="round"
              id="progress-circle"/>
          </svg>
          <span class="progress-pct" id="progress-pct" aria-live="polite">0%</span>
        </div>
        <div class="progress-meta">
          <span class="progress-label">Tiến độ tổng</span>
          <span class="progress-detail" id="progress-detail">0 / {totalSessions} buổi hoàn thành</span>
          <StreakStrip />
        </div>
      </div>
    </header>

    <div class="resume-card" id="resume-card">
      <div class="resume-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      </div>
      <div class="resume-text">
        <strong>Tiếp tục học</strong>
        <span>Nhảy tới buổi bạn xem gần nhất — hoặc buổi tiếp theo chưa hoàn thành.</span>
      </div>
      <a class="resume-link" id="resume-link" href={`/sessions/${sessions[0].slug}/`}>
        Vào học ngay
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </div>

    <div class="dash-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="card-search-input" placeholder="Tìm buổi theo tên, artifact, chủ đề…" autocomplete="off" />
    </div>

    <!-- Phase filter strip -->
    <nav class="phase-strip" aria-label="Lọc theo giai đoạn">
      <button class="phase-tab active" data-filter="all">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Tất cả
        <span class="tab-count">{totalSessions}</span>
      </button>
      {groups.map((group) => (
        <button class="phase-tab" data-filter={group.phase} style={`--tab-color: ${phaseColors[group.phase]}`}>
          <span set:html={phaseIcons[group.phase]} />
          {group.phase}
          <span class="tab-count">{group.sessions.length}</span>
        </button>
      ))}
    </nav>

    <!-- Phase sections -->
    {groups.map((group, gIdx) => (
      <section class="phase-section" data-phase={group.phase} id={`phase-${group.phase.toLowerCase()}`}>
        <div class="phase-section-header" style={`--phase-color: ${phaseColors[group.phase]}`}>
          <div class="phase-section-icon" set:html={phaseIcons[group.phase]} />
          <div>
            <h2 class="phase-section-title">Phase {gIdx + 1} — {group.phase}</h2>
            <p class="phase-section-desc">{group.sessions.length} buổi học</p>
          </div>
          <div class="phase-progress-bar">
            <div class="phase-progress-fill" data-phase-bar={group.phase} style="width: 0%"></div>
          </div>
        </div>

        <div class="session-grid">
          {group.sessions.map((session) => (
            <article class="dash-card" data-session={session.number} data-check-total={totalChecks(session)}>
              <a href={`/sessions/${session.slug}/`} class="dash-card-link">
                <!-- Card top: image + overlay badge -->
                <div class="dash-card-visual">
                  <img src={session.heroImage} alt={`Buổi ${session.number}: ${session.topic}`} width="640" height="360" loading="lazy" />
                  <span class="dash-card-num">
                    {session.number.toString().padStart(2, "0")}
                  </span>
                </div>

                <!-- Card body -->
                <div class="dash-card-body">
                  <div class="dash-card-meta">
                    <span class="phase-badge" data-phase={session.phase}>{session.phase}</span>
                    <ModuleStatusIcon sessionNumber={session.number} />
                  </div>

                  <h3 class="dash-card-title">{session.topic}</h3>
                  <p class="dash-card-summary">{session.summary}</p>

                  <!-- Artifact & checklist stats -->
                  <div class="dash-card-stats">
                    <div class="dash-stat">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                      <span>{session.artifact || "—"}</span>
                    </div>
                    <div class="dash-stat">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                      <span>{session.guidance.successCriteria.length} checkpoints</span>
                    </div>
                  </div>

                  <div class="dash-check-row">
                    <div class="dash-check-bar"><div class="dash-check-bar-fill"></div></div>
                    <span class="dash-check-pct">0%</span>
                  </div>
                </div>
              </a>
              <!-- Completion checkbox (outside link — fix nested interactive P0) -->
              <div class="dash-card-footer">
                <label class="completion-check">
                  <input type="checkbox" class="session-done-check" data-session-num={session.number} />
                  <span class="check-label">Đã hoàn thành</span>
                </label>
                <span class="card-cta">
                  Vào học
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </span>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  /* ═══════════════════════════════════════
     STUDENT DASHBOARD STYLES
     ═══════════════════════════════════════ */
  .dashboard {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-lg, 2rem) var(--space-md, 1.5rem);
  }

  /* ── Header ── */
  .dash-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xl, 2rem);
    margin-bottom: var(--space-xl, 2rem);
    flex-wrap: wrap;
  }

  .dash-header-text { flex: 1; min-width: 300px; }

  .dash-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary, #e64a19);
    background: rgba(230, 74, 25, 0.07);
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: var(--space-sm, 0.75rem);
    border: 1px solid rgba(230, 74, 25, 0.12);
  }

  .dash-header h1 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-sm, 0.75rem);
    color: var(--text-primary, #0f172a);
  }

  .dash-header p {
    font-size: 0.95rem;
    color: var(--text-secondary, #64748b);
    max-width: 560px;
    line-height: 1.65;
    margin: 0;
  }

  /* Progress ring */
  .global-progress {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 28px;
    background: var(--bg-glass, rgba(255,255,255,0.85));
    backdrop-filter: blur(12px);
    border: 1px solid var(--border, rgba(0,0,0,0.08));
    border-radius: 20px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.04);
  }

  .progress-ring-big {
    position: relative;
    width: 80px; height: 80px;
    flex-shrink: 0;
  }

  .progress-ring-big svg {
    width: 80px; height: 80px;
    transform: rotate(-90deg);
  }

  .progress-pct {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--accent-primary, #e64a19);
  }

  .progress-meta { display: flex; flex-direction: column; gap: 4px; }
  .progress-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted, #94a3b8); }
  .progress-detail { font-size: 0.92rem; font-weight: 700; color: var(--text-primary, #0f172a); }

  /* ── Phase filter strip ── */
  .phase-strip {
    display: flex;
    gap: 8px;
    padding: var(--space-md, 1rem) 0;
    margin-bottom: var(--space-lg, 1.5rem);
    border-bottom: 1px solid var(--border, rgba(0,0,0,0.08));
    overflow-x: auto;
    scrollbar-width: none;
  }
  .phase-strip::-webkit-scrollbar { display: none; }

  .phase-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    min-height: 40px;
    border-radius: 100px;
    border: 1px solid var(--border, rgba(0,0,0,0.1));
    background: var(--bg-base, #fff);
    color: var(--text-secondary, #64748b);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .phase-tab:hover {
    border-color: var(--tab-color, var(--accent-primary, #e64a19));
    color: var(--text-primary, #0f172a);
  }

  .phase-tab.active {
    background: var(--tab-color, var(--accent-primary, #e64a19));
    color: white;
    border-color: transparent;
  }

  .tab-count {
    font-size: 0.7rem;
    font-weight: 800;
    background: rgba(0,0,0,0.08);
    padding: 2px 7px;
    border-radius: 100px;
  }
  .phase-tab.active .tab-count {
    background: rgba(255,255,255,0.25);
  }

  /* ── Phase sections ── */
  .phase-section { margin-bottom: var(--space-2xl, 3rem); }
  .phase-section.hidden { display: none; }

  .phase-section-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: var(--space-lg, 1.5rem);
    flex-wrap: wrap;
  }

  .phase-section-icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--phase-color) 12%, transparent);
    color: var(--phase-color);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .phase-section-title {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0;
    color: var(--text-primary, #0f172a);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .phase-section-desc {
    font-size: 0.82rem;
    color: var(--text-secondary, #64748b);
    margin: 2px 0 0;
  }

  .phase-progress-bar {
    margin-left: auto;
    width: 120px;
    height: 6px;
    background: var(--bg-inset, #f1f5f9);
    border-radius: 6px;
    overflow: hidden;
  }

  .phase-progress-fill {
    height: 100%;
    background: var(--phase-color);
    border-radius: 6px;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── Session grid ── */
  .session-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  /* ── Dashboard Card ── */
  .dash-card {
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-glass, rgba(255,255,255,0.9));
    backdrop-filter: blur(12px);
    border: 1px solid var(--border, rgba(0,0,0,0.08));
    box-shadow: 0 2px 16px rgba(0,0,0,0.04);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dash-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.1);
  }

  .dash-card.completed {
    opacity: 0.7;
    border-color: var(--success, #10b981);
  }

  .dash-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .dash-card-visual {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  .dash-card-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .dash-card:hover .dash-card-visual img {
    transform: scale(1.05);
  }

  .dash-card-num {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    color: white;
    font-size: 0.85rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dash-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .dash-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dash-card-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-primary, #0f172a);
    margin: 0;
    line-height: 1.3;
  }

  .dash-card-summary {
    font-size: 0.85rem;
    color: var(--text-secondary, #64748b);
    margin: 0;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dash-card-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--border, rgba(0,0,0,0.08));
  }

  .dash-stat {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted, #94a3b8);
  }

  .dash-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 12px;
  }

  .completion-check {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary, #64748b);
  }

  .completion-check input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--success, #10b981);
    cursor: pointer;
  }

  .card-cta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-primary, #e64a19);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s, transform 0.2s;
  }

  .dash-card:hover .card-cta {
    opacity: 1;
    transform: translateX(0);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .dash-header { flex-direction: column; align-items: flex-start; }
    .global-progress { width: 100%; }
    .session-grid { grid-template-columns: 1fr; }
    .phase-progress-bar { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dash-card, .card-cta, .phase-tab { transition: none; }
    .dash-card:hover { transform: none; }
    .dash-card:hover .dash-card-visual img { transform: none; }
  }
</style>

<script>
  // Phase filtering
  document.querySelectorAll('.phase-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.getAttribute('data-filter');
      document.querySelectorAll('.phase-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      document.querySelectorAll('.phase-section').forEach(section => {
        section.classList.toggle('hidden', !(filter === 'all' || section.getAttribute('data-phase') === filter));
      });
    });
  });

  // Keyword search across session cards
  const searchInput = document.getElementById('card-search-input') as HTMLInputElement | null;
  if (searchInput) {
    const norm = (s: string): string => (s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    searchInput.addEventListener('input', () => {
      const q = norm(searchInput.value.trim());
      document.querySelectorAll('.dash-card').forEach(card => {
        const text = norm(card.textContent || '');
        card.classList.toggle('is-hidden', Boolean(q) && !text.includes(q));
      });
    });
  }
</script>
